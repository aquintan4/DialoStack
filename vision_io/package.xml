<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_io</name>
  <version>0.0.0</version>

  <license>MIT</license>

  <description>
    Vision input package for ROS 2. Provides camera-agnostic nodes for facial
    emotion detection and lip activity detection, used by the dialogue manager
    to support barge-in and emotional context.
  </description>

  <maintainer email="aquintana.camacho@proton.me">aquintan4</maintainer>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
