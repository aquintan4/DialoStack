  <version>0.0.0</version>
  <description>BehaviorTree.CPP leaf node that runs a DialoStack dialogue task, with a generic tree runner and an example.</description>
  <maintainer email="aquintana.camacho@proton.me">aquintan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp</depend>
  <depend>ros2_dialog_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
