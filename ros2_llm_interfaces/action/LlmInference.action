# Goal
string session_id
string prompt
int32  max_tokens
string format_schema
int32  cache_prefix_len   # Optional. Length (characters) of the leading part of `prompt`
                          # that repeats across calls (instructions, session context).
                          # Providers with prompt caching cache it. 0 = no hint.
---
# Result
bool    success
string  answer
float64 total_time
int32   prompt_tokens
int32   completion_tokens
string  status
---
# Feedback
string partial_text
int32  tokens_generated
